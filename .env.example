# ─────────────────────────────────────────────────────────────
# Collection Africa — environment variables
# Copy to .env.local for development, set in your host for production.
# Everything here is documented in docs/user-guide.md
# ─────────────────────────────────────────────────────────────

# Public site URL. No trailing slash. Used for canonicals, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Content management (Payload CMS) ─────────────────────────
# Leave both blank and the site runs entirely from the files in /content.
# Fill them in and the admin panel at /admin takes over.
# Any Postgres will do: local, Neon, Supabase, Railway.
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/collectionafrica
# Generate with:  openssl rand -base64 32
PAYLOAD_SECRET=

# Only read by `npm run cms:seed`, to create the first admin account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── SMTP (contact + careers forms) ───────────────────────────
SMTP_HOST=mail.collectionafrica.co.ke
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=website@collectionafrica.co.ke
SMTP_PASS=
MAIL_FROM="Collection Africa Website <website@collectionafrica.co.ke>"
MAIL_TO_ENQUIRIES=marketing@collectionafrica.co.ke
MAIL_TO_CAREERS=hr@collectionafrica.co.ke

# ── Tawk.to live chat + AI assist ────────────────────────────
# Dashboard > Administration > Channels > Chat Widget.
# The embed URL looks like https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=1i000000000

# ── Claude (on-site assistant + AI search) ───────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Set to false to hide the on-site assistant without redeploying.
NEXT_PUBLIC_ENABLE_ASSISTANT=true
NEXT_PUBLIC_ENABLE_AI_SEARCH=true

# ── Analytics (optional) ─────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# ── Search Console / verification (optional) ─────────────────
GOOGLE_SITE_VERIFICATION=
